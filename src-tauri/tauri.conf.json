{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MpBPO PDF Studio",
  "version": "0.2.9",
  "identifier": "com.splitpdf.studio",
  "build": {
    "beforeDevCommand": "node ./scripts/ensure-vite-dev.mjs",
    "beforeBuildCommand": "node scripts/prepare-webview2.mjs --check && pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MpBPO PDF Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'self'; connect-src 'self' https://github.com https://objects.githubusercontent.com https://*.githubusercontent.com; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/SplitPDFStudio/thumbnail-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "fixedRuntime", "path": "resources/webview2" },
      "nsis": { "installerHooks": "windows/installer-hooks.nsh" }
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/boyboyboy321/mpbpo-pdf-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMTZFMTU1OTE0NTk2NUYKUldSZmxrV1JWZUVXa3dmS0lSSms5ek8vYkhUUXAzMUVDR2F2VkdHS043NG9aRHRNK2VDT0tlcnYK"
    }
  }
}
